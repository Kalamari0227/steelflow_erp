{
  "name": "steelflow-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/storage.mjs run --category disposable-test -- node_modules/.bin/vitest run",
    "pretest:e2e": "node scripts/storage.mjs check --include-legacy",
    "test:e2e": "playwright test",
    "storage:report": "node scripts/storage.mjs report",
    "storage:check": "node scripts/storage.mjs check",
    "storage:clean": "node scripts/storage.mjs clean",
    "test:storage": "node --test scripts/storage.test.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14",
    "three": "^0.180.0",
    "zustand": "^5.0.8",
    "zod": "^4.1.12",
    "ky": "^1.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^5.0.5"
  }
}
