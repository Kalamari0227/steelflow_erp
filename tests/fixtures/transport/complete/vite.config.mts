import {defineConfig} from 'vite';
import {resolve} from 'node:path';
import {readFileSync,existsSync,realpathSync} from 'node:fs';
import {createHash} from 'node:crypto';
const keys=['STEELFLOW_COMPLETE_ASSETS','STEELFLOW_COMPLETE_CONTRACTS','STEELFLOW_COMPLETE_MATERIAL','STEELFLOW_COMPLETE_WORLD','STEELFLOW_COMPLETE_RUN','STEELFLOW_COMPLETE_SHA'] as const;
for(const key of keys)if(!process.env[key])throw Error('Explicit complete-source input missing: '+key);
const assets=realpathSync(process.env.STEELFLOW_COMPLETE_ASSETS!),contracts=realpathSync(process.env.STEELFLOW_COMPLETE_CONTRACTS!),material=realpathSync(process.env.STEELFLOW_COMPLETE_MATERIAL!),world=realpathSync(process.env.STEELFLOW_COMPLETE_WORLD!),run=realpathSync(process.env.STEELFLOW_COMPLETE_RUN!);
const bytes=readFileSync(resolve(assets,'public/assets/steelworks/transport/manifest.json'));if(createHash('sha256').update(bytes).digest('hex')!==process.env.STEELFLOW_COMPLETE_SHA)throw Error('Pinned complete-source manifest changed');
const files=new Map([['/handling-source-domain.json',resolve(world,'source-domain.json')],...[0,1,2].flatMap(lod=>['unload','load-source'].map(direction=>[`/handling-fixture/lod${lod}/drop1-${direction}.json`,resolve(world,`lod${lod}/drop1-${direction}.json`)] as [string,string]))]);
export default defineConfig({publicDir:resolve(assets,'public'),cacheDir:resolve(run,'vite-cache'),resolve:{dedupe:['three']},plugins:[{name:'pinned-complete-source-inputs',configureServer(server){server.middlewares.use((req,res,next)=>{const url=new URL(req.url??'/', 'http://127.0.0.1');if(url.pathname==='/complete-config.json'){res.setHeader('Content-Type','application/json');res.end(JSON.stringify({manifestSha:process.env.STEELFLOW_COMPLETE_SHA,loaderModule:'/@fs'+resolve(contracts,'src/operations/scene/assets/loader.ts'),manifestModule:'/@fs'+resolve(contracts,'src/operations/scene/assets/manifest.ts'),factoryModule:'/@fs'+resolve(material,'src/operations/scene/materials/versionCoilGeometry.ts')}));return;}if(url.pathname==='/complete-imports.json'){const rows=[...server.moduleGraph.idToModuleMap.values()].flatMap(module=>module.file&&existsSync(module.file)?[{path:module.file,sha256:createHash('sha256').update(readFileSync(module.file)).digest('hex')}]:[]);res.setHeader('Content-Type','application/json');res.end(JSON.stringify(rows));return;}const file=files.get(url.pathname);if(file){res.setHeader('Content-Type','application/json');res.end(readFileSync(file));return;}next();});}}],server:{host:'127.0.0.1',strictPort:true,watch:{ignored:['**/*']},fs:{allow:[resolve('.')]}}});
